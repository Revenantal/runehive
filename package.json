{
  "name": "runehive",
  "version": "0.0.0",
  "private": true,
  "description": "Autonomous agents that learn to play a private LostCity Revision 274 world.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "runehive": "tools/runehive.mjs"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "runehive": "node tools/runehive.mjs",
    "experiment:headless": "node tools/headless-experiment/cli.mjs",
    "start": "node tools/runehive.mjs start",
    "stop": "node tools/runehive.mjs stop",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run lint && npm run format:check && npm test",
    "docs:sync": "node tools/docs-sync.mjs",
    "docs:check": "node tools/docs-sync.mjs --check",
    "hooks:install": "node tools/install-hooks.mjs",
    "prepare": "node tools/install-hooks.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.15.0",
    "eslint-plugin-jsdoc": "65.4.8",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
